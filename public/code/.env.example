# ============================================
# 2Captcha Bot - Configuração
# ============================================

# API Key do 2captcha (obrigatório)
# Obtenha em: https://2captcha.com/enterpage
TWOCAPTCHA_API_KEY=sua_api_key_aqui

# URL alvo onde o CAPTCHA está
TARGET_URL=https://exemplo.com/login

# Site Key do CAPTCHA (se não for detectada automaticamente)
SITE_KEY=6Le-wvkSAAAAAPBMRTvw0Q4Muexq9bi0DJwx_mJ-

# ============================================
# Configurações de Retry
# ============================================
MAX_RETRIES=3
TIMEOUT=120
POLLING_INTERVAL=5
SOFT_TIMEOUT=300

# ============================================
# Configurações do Navegador
# ============================================
BROWSER=chrome
HEADLESS=true

# ============================================
# Proxy (opcional)
# ============================================
PROXY_TYPE=
PROXY_ADDRESS=

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Callback (opcional)
# ============================================
CALLBACK_URL=
